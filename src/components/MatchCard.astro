---
import type { Match } from '../lib/sports.ts';
import { readSports } from '../lib/sports-data.ts';
import { sportsAssets } from '../lib/sports-assets.ts';
import { renderMatch } from '../lib/sports-html.ts';
interface Props { match: Match; anchor?: boolean; logos?: boolean; compact?: boolean; }
const { match, anchor = true, logos = false, compact = false } = Astro.props;
const assets = await sportsAssets(readSports());
---
<Fragment set:html={renderMatch(match, assets, { anchor, logos, compact })} />
