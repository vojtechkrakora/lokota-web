---
import { Image } from 'astro:assets';
import { clubEmblem } from '../lib/club-logos.ts';
interface Props { clubId: number; }
const emblem = clubEmblem(Astro.props.clubId);
---
{emblem ? <Image src={emblem} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" fit="contain" format="webp" loading="lazy" class="team-logo" /> : <span class="team-logo team-logo-placeholder" aria-hidden="true" title="Znak není k dispozici">—</span>}
