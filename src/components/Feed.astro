---
import type { CollectionEntry } from 'astro:content';
import type { FeedItem } from '../lib/feed.ts';
import { readSports } from '../lib/sports-data.ts';
import { sportsAssets } from '../lib/sports-assets.ts';
import { renderFeed } from '../lib/sports-html.ts';
interface Props { items: FeedItem[]; news: CollectionEntry<'news'>[]; featured?: boolean; }
const { items, news, featured = false } = Astro.props;
const assets = await sportsAssets(readSports(), news);
---
<Fragment set:html={renderFeed(items, assets, featured)} />
