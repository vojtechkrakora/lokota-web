---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { publicContent } from '../../lib/content.ts';
import { formatDate } from '../../lib/dates.ts';
export async function getStaticPaths() {
  return (await publicContent()).news.map(entry => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const cover = entry.data.cover;
const downloads = entry.data.downloads ?? [];
---
<Layout title={entry.data.title} description={entry.data.summary} image={cover?.src.src}><article class="article"><header class="page-heading"><a class="text-link" href="/novinky/">← Novinky</a><p class="eyebrow"><time datetime={entry.data.publicationDate}>{formatDate(entry.data.publicationDate)}</time>{entry.data.author && ` · ${entry.data.author}`}</p><h1>{entry.data.title}</h1><p>{entry.data.summary}</p></header>{cover && <figure class="article-cover"><Image src={cover.src} alt={cover.alt} width={Math.min(cover.src.width, 1200)} layout="constrained" loading="eager" fetchpriority="high" />{cover.caption && <figcaption>{cover.caption}</figcaption>}</figure>}<div class="prose"><Content /></div>{downloads.length > 0 && <section class="downloads" aria-labelledby="article-downloads"><h2 id="article-downloads">Ke stažení</h2><ul>{downloads.map(file => <li><a href={file.path} download>{file.label} ↓</a></li>)}</ul></section>}<Gallery pictures={entry.data.gallery} /></article></Layout>
