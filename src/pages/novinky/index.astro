---
import Layout from '../../layouts/Layout.astro';
import Feed from '../../components/Feed.astro';
import Pagination from '../../components/Pagination.astro';
import { feedContent } from '../../lib/content.ts';
import { paginate } from '../../lib/feed.ts';
const { feed, news } = await feedContent();
const pages = paginate(feed);
const years = [...new Set(news.map(n => n.data.publicationDate.slice(0, 4)))];
---
<Layout title="Novinky" description="Klubové zprávy a oficiální výsledky zápasů KK Lokomotiva Tábor, od nejnovějších."><header class="page-heading"><p class="eyebrow">Klubové dění</p><h1>Novinky</h1><p>Klubové zprávy a výsledky. Nejnovější vždy nahoře.</p><p data-news-page-label hidden></p></header><div class="reading-wide"><h2 class="sr-only">Poslední zprávy</h2><div data-sports-slot="news"><Feed items={pages[0]!.items} news={news} featured /><Pagination page={1} total={pages.length} /></div>{years.length > 0 && <nav class="archive-links" aria-label="Archiv článků"><h2>Archiv klubových článků</h2>{years.map(year => <a href={`/novinky/archiv/${year}/`}>{year}</a>)}</nav>}</div></Layout>
