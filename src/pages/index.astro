---
import { Image } from 'astro:assets';
import homeIllustration from '../assets/home-intro-2026-11-13.png';
import Layout from '../layouts/Layout.astro';
import FeaturedNews from '../components/FeaturedNews.astro';
import TableScroll from '../components/TableScroll.astro';
import { feedContent } from '../lib/content.ts';
import { sportsAssets } from '../lib/sports-assets.ts';
import { renderHomeMatches, renderTables, renderTeamOverview } from '../lib/sports-html.ts';
const { sports, news, current } = await feedContent();
const assets = await sportsAssets(sports);
---
<Layout title="Kuželky v Táboře" description="Novinky KK Lokomotiva Tábor, zápasy, oficiální výsledky a tabulky. Turnaj dvojic Žižkova 200.">
  <header class="home-masthead">
    <div class="home-introduction"><div><p class="eyebrow">KK Lokomotiva Tábor</p><h1>Kuželky v Táboře.</h1></div><p class="home-season">Sezóna <strong data-sports-season>{sports.season.name}</strong><span data-sports-slot="home-counts">{sports.teams.length} družstev · {sports.competitions.length} soutěží</span></p></div>
    <Image src={homeIllustration} alt="Dvojitý čtvrtek doma, v sobotu Hazlov. Čtyři zápasy pro naše barvy. Včera doma dvakrát 1:5." width={224} widths={[128, 224, 256, 448]} sizes="(max-width: 760px) 128px, 224px" format="webp" quality={82} loading="eager" class="home-intro-image" />
  </header>
  <section id="aktualne" class="home-news" aria-label="Aktuální články">
    <h2 class="sr-only">Zprávy z klubu</h2>
    <FeaturedNews news={news.slice(0, 4)} />
    <div class="home-news-more"><a class="text-link" href="/novinky/">Všechny články <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="home-sports" aria-labelledby="home-matches-heading" data-sports-slot="home-matches" set:html={renderHomeMatches(sports, assets)} />
  <div class="home-club-overview">
      <section class="home-standings" data-team-color="red" aria-labelledby="a-team-heading">
        <div class="section-heading"><div><p class="eyebrow">Sezóna <span data-sports-season>{sports.season.name}</span></p><h2 id="a-team-heading">Tabulka A-týmu</h2></div><a class="text-link" href="/tabulky/">Všechny tabulky <span aria-hidden="true">→</span></a></div>
        <div data-sports-slot="home-table" set:html={renderTables(sports, true)} />
      </section>
  <div class="home-club-links">
      <section class="standing-summary" data-sports-slot="home-teams" set:html={renderTeamOverview(sports)} />
      <section class="tournament-promo"><p class="eyebrow">Turnaj dvojic</p><h2>Žižkova 200</h2><p>200 hodů sdružených.</p><p class="small">{current ? `${current.data.year} · ${current.data.description}` : 'Informace o dalším ročníku připravujeme.'}</p><a href="/zizkova-200/" class="text-link">Informace a výsledky →</a></section>
  </div>
  </div>
<TableScroll label="" scriptOnly /></Layout>
