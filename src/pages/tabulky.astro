---
import Layout from '../layouts/Layout.astro';
import TableScroll from '../components/TableScroll.astro';
import { readSports } from '../lib/sports-data.ts';
import { renderTables } from '../lib/sports-html.ts';
const sports = readSports();
---
<Layout title="Ligové tabulky" description="Aktuální oficiální ligové tabulky soutěží KK Lokomotiva Tábor."><header class="page-heading"><p class="eyebrow">Sezóna <span data-sports-season>{sports.season.name}</span></p><h1>Jak si stojíme</h1><p>Oficiální tabulky ČKA. Naše družstva jsou zvýrazněná.</p></header>
<div data-sports-slot="tables" set:html={renderTables(sports)} />
<TableScroll label="" scriptOnly />
<p class="small page-note">Pořadí i body přebíráme od ČKA a nepřepočítáváme je. Po skončení zápasu může aktualizace u zdroje chvíli trvat.</p></Layout>
