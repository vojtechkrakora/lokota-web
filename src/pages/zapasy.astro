---
import Layout from '../layouts/Layout.astro';
import { readSports } from '../lib/sports-data.ts';
import { sportsAssets } from '../lib/sports-assets.ts';
import { renderMatches } from '../lib/sports-html.ts';
const sports = readSports();
const assets = await sportsAssets(sports);
---
<Layout title="Zápasy a výsledky" description="Rozpis a oficiální výsledky zápasů všech družstev KK Lokomotiva Tábor."><header class="page-heading"><p class="eyebrow">Sezóna <span data-sports-season>{sports.season.name}</span></p><h1>Zápasy a výsledky</h1><p>Všechna naše družstva. Termíny, místa a výsledky podle ČKA.</p></header>
<div data-sports-slot="matches" set:html={renderMatches(sports, assets)} />
<p class="small page-note">Pořadí skóre: domácí : hosté. Pomlčka znamená, že údaj nebyl zveřejněn. Časy zobrazujeme jako místní český čas; nejde o živé výsledky.</p></Layout>
