---
import Layout from '../../layouts/Layout.astro';
import TournamentHeader from '../../components/TournamentHeader.astro';
import { publicContent } from '../../lib/content.ts';
import { hasTournamentResults } from '../../lib/tournament-overview.ts';
import '../../styles/tournament.css';
const { tournaments, current } = await publicContent();
const past = tournaments.filter(entry => entry.data.archived && entry.data.results.length > 0);
---
<Layout title="Archiv Žižkovy 200" description="Ročníky turnaje dvojic Žižkova 200 v Táboře. Kompletní výsledky, vítězné dvojice a hledání hráčů nebo oddílů.">
  <TournamentHeader editions={tournaments} currentYear={current?.data.year} archive />
  <div class="tournament-layout">
    <section class="tournament-main" aria-labelledby="archiv-heading">
      <header class="tournament-section-heading"><div><p class="eyebrow">Od letoška do historie</p><h2 id="archiv-heading">Vyberte si ročník.</h2></div></header>
      {tournaments.length ? <ul class="tournament-archive-list">{tournaments.map(entry => {
        const pairs = entry.data.results.reduce((sum, group) => sum + group.pairs.length, 0);
        const results = hasTournamentResults(entry);
        return <li><a class="tournament-archive-card" href={`/zizkova-200/${entry.data.year}/`}>
          <strong class="tournament-archive-year">{entry.data.year}</strong>
          <div><p class="eyebrow">{entry.data.year === current?.data.year ? 'Aktuální ročník' : 'Historický ročník'}</p><h2>{entry.data.name}</h2><p class="small">{pairs > 0 ? `${pairs} dvojic · ${pairs * 2} hráčských startů` : results ? 'Zveřejněné výsledky' : 'Výsledky zatím nejsou zveřejněny'}</p><span class="tournament-archive-action">{results ? 'Výsledky a hledání hráčů' : 'Informace a propozice'}</span></div>
          <span aria-hidden="true">→</span>
        </a></li>;
      })}</ul> : <div class="empty-state"><h2>Archiv zatím čeká na podklady</h2><p>Starší ročníky zde mohou být postupně doplněny.</p></div>}
    </section>
    {past.length > 0 && <aside class="tournament-sidebar" aria-label="Vítězné dvojice minulých ročníků">
      <section class="tournament-panel"><p class="eyebrow">Zapsali se do historie</p><h2>Vítězné dvojice</h2>
        <ul class="tournament-history-winners">{past.flatMap(entry => entry.data.results.flatMap(group => group.pairs.filter(pair => pair.position === 1).map(pair => <li>
          <a href={`/zizkova-200/${entry.data.year}/#vysledky-${entry.data.year}-${group.id}`}>{entry.data.year} · {group.label} <span aria-hidden="true">↗</span></a>
          {pair.players.map(player => <p>{player.name}</p>)}
          <p class="small">{pair.total} kuželek za dvojici</p>
        </li>)))}</ul>
      </section>
    </aside>}
  </div>
</Layout>
