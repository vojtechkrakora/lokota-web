---
import Layout from '../../layouts/Layout.astro';
import Edition from '../../components/Edition.astro';
import { publicContent } from '../../lib/content.ts';
const { current } = await publicContent();
---
<Layout title="Žižkova 200" description="Klubový turnaj dvojic Žižkova 200 — 200 hodů sdružených. Informace, výsledky a archiv ročníků."><header class="page-heading tournament-heading"><p class="eyebrow">Klubový turnaj dvojic</p><h1>Žižkova <span>200</span></h1><p>200 hodů sdružených. Dva hráči, jeden tým.</p><a class="text-link" href="/zizkova-200/archiv/">Archiv ročníků ↗</a></header><div class="reading-wide">{current ? <><Edition entry={current} /><a class="text-link" href={`/zizkova-200/${current.data.year}/`}>Stálý odkaz na ročník {current.data.year} ↗</a></> : <div class="empty-state"><h2>Další ročník připravujeme</h2><p>Termín, propozice a výsledky zveřejníme, jakmile budou potvrzené. Případná kvalifikace na MČR se uvádí u konkrétního ročníku.</p></div>}</div></Layout>
