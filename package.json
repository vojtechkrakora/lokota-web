{
  "name": "lokota-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/prepare-sports.ts && astro dev --host 0.0.0.0",
    "dev:offline": "node scripts/prepare-sports.ts --fixture && astro dev --host 0.0.0.0",
    "logos:update": "node scripts/prepare-sports.ts --update-club-logos",
    "check": "astro check && node scripts/check-content.ts",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run check:functions",
    "build": "npm run verify && node scripts/build.ts",
    "build:offline": "npm run verify && node scripts/build.ts --fixture",
    "test:editorial": "node scripts/content-smoke.ts",
    "preview": "astro preview --host 0.0.0.0",
    "check:functions": "wrangler pages functions build --outdir .cache/functions-check",
    "preview:runtime": "wrangler pages dev dist --port 4321 --ip 0.0.0.0 --persist-to .cache/workerd"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
